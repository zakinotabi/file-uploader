<main>
  <h1>Dashboard</h1>

  <section aria-labelledby="storage-heading">
    <h2 id="storage-heading">Storage</h2>
    <!-- storage summary text, e.g. "{usedGb} GB of {totalGb} GB used" -->
    <p></p>
    <!-- progress bar: value = usedGb, max = totalGb -->
    <progress value="" max=""></progress>
  </section>

  <section aria-labelledby="upload-heading">
    <h2 id="upload-heading">Upload a file</h2>
    <form action="/files" method="POST" enctype="multipart/form-data">
      <label for="dashboard-file">Choose a file (max 10 MB: pdf, png, jpg, docx, xlsx, zip, mp4)</label>
      <input id="dashboard-file" name="file" type="file" accept=".pdf,.png,.jpg,.jpeg,.docx,.xlsx,.zip,.mp4" required />
      <button type="submit">Upload</button>
    </form>
  </section>

  <section aria-labelledby="recent-folders-heading">
    <h2 id="recent-folders-heading">Recent folders</h2>
    <ul>
      <!--
        Loop over recent folders. One row example:
        <li>
          <a href="/folders/{folder.id}">{folder.name}</a>
          <p>{folder.fileCount} files &middot; {folder.sizeHuman}</p>
        </li>
      -->
    </ul>
    <a href="/folders">View all folders</a>
  </section>

  <section aria-labelledby="recent-files-heading">
    <h2 id="recent-files-heading">Recent files</h2>
    <table>
      <thead>
        <tr>
          <th scope="col">Name</th>
          <th scope="col">Size</th>
          <th scope="col">Uploaded</th>
          <th scope="col">Actions</th>
        </tr>
      </thead>
      <tbody>
        <!--
          Loop over recent files. One row example:
          <tr>
            <td>
              <a href="/files/{file.id}">{file.name}</a>
              <p>in <a href="/folders/{file.folderId}">{file.folderName}</a></p>
            </td>
            <td>{file.sizeHuman}</td>
            <td><time datetime="{file.uploadedAtISO}">{file.uploadedAtHuman}</time></td>
            <td>
              <a href="/files/{file.id}/download">Download</a>
              <button type="button" data-open="file-details-modal">Details</button>
            </td>
          </tr>
        -->
      </tbody>
    </table>
    <a href="/files">View all files</a>
  </section>
</main>
