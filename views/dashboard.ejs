<main class="page-shell">
  <div class="page-head">
    <div>
      <h1>My Drive</h1>
      <div class="meta"><%= (folders?.length || 0) %> folders · <%= (files?.length || 0) %> files · <%= userStorage %> used</div>
    </div>
  </div>

  <div class="section-title-row">
    <a href="/folders" class="section-title">Folders <span class="badge"><%= folders?.length || 0 %></span></a>
    <div class="section-actions">
      <div class="seg compact">
        <button class="on" type="button" title="Grid"><svg class="icon"><use href="#i-grid"/></svg></button>
        <button type="button" title="List"><svg class="icon"><use href="#i-list"/></svg></button>
      </div>
      <button class="btn" type="button" data-open="new-folder-modal"><svg class="icon"><use href="#i-plus"/></svg> New folder</button>
    </div>
  </div>
  <div class="folders">
    <% folders?.forEach(folder => { %>
      <div class="folder-card">
        <a class="folder-card-link" href="/folders/<%= folder.id %>">
          <div class="folder-ico"><svg class="icon"><use href="#i-folder"/></svg></div>
          <div style="min-width:0">
            <div class="f-name"><%= folder.folderName %><% if (folder.public) { %><svg class="icon folder-public-icon"><use href="#i-public" /></svg><% } %></div>
            <div class="f-meta"><%= folder.files?.length || 0 %> files</div>
          </div>
        </a>

        <div class="folder-actions">
          <button class="mini folder-action folder-share-button" type="button" data-folder-id="<%= folder.id %>" data-open="share-folder-modal-<%= folder.id %>" title="Share folder">
            <svg class="icon"><use href="#i-share" /></svg>
          </button>
          <button class="mini folder-action" type="button" data-open="edit-folder-modal-<%= folder.id %>" title="Edit folder">
            <svg class="icon"><use href="#i-edit" /></svg>
          </button>
          <% if (!folder.isRoot) {%>
            <button class="mini folder-action danger" type="button" data-open="delete-folder-modal-<%= folder.id %>" title="Delete folder">
            <svg class="icon"><use href="#i-trash" /></svg>
          </button>
         <%} %>
          
        </div>
      </div>

      <%- include('partials/modals/shareFolder', { folder: folder }) %>
      <%- include('partials/modals/editFolder', { folder: folder }) %>
      <%- include('partials/modals/deleteFolder', { folder: folder }) %>
    <% }) %>
  </div>

  <div class="section-title-row">
    <a href="/files" class="section-title">Files <span class="badge"><%= files?.length || 0 %></span></a>
    <div class="section-actions">
      <div class="seg compact">
        <button  type="button" title="Grid"><svg class="icon"><use href="#i-grid"/></svg></button>
        <button class="on" type="button" title="List"><svg class="icon"><use href="#i-list"/></svg></button>
      </div>
      <button class="btn primary" type="button" data-open="add-file-modal"><svg class="icon"><use href="#i-upload"/></svg> Upload file</button>
    </div>
  </div>

  <div class="table">
    <table class="file-table">
      <thead>
        <tr>
          <th>Name</th>
          <th class="size-column">Size</th>
          <th class="date-column">Uploaded</th>
          <th class="visibility-column">Visibility</th>
          <th class="actions-column"></th>
        </tr>
      </thead>
      <tbody>
        <% files?.forEach(file => { %>
          <tr class="js-file file-modal-open" data-file-id="<%= file.id %>">
            <td>
              <div class="fcell">
                <div class="badge-file"><img src="https://icon-forge.el3zahaby.workers.dev/file-icon?ext=<%= file.fileName.split('.')[1] || "file"%>" alt=""></div>
                <div style="min-width:0">
                  <div class="fname"><%= file.fileName %></div>
                  <div class="fsub"><%= file.folder?.folderName || 'Unsorted' %></div>
                </div>
              </div>
            </td>
            <td class="size-column"><%= file.size %></td>
            <td class="date-column"><%= file.createdAt?.toLocaleDateString() || '' %></td>
            <td class="visibility-column">
              <span class="visibility-status <%= file.public ? 'public' : 'private' %>">
                <% if (file.public) { %><svg class="icon"><use href="#i-public" /></svg><% } %>
                <%= file.public ? 'Public' : 'Private' %>
              </span>
            </td>
            <td class="actions-column">
              <div class="actions" onclick="event.stopPropagation()">
                <a class="mini" href="/files/<%= file.id %>/download" title="Download"><svg class="icon"><use href="#i-download"/></svg></a>
                <button class="mini file-details-button" type="button" data-file-id="<%= file.id %>" title="Details"><svg class="icon"><use href="#i-share"/></svg></button>
                <button class="mini" type="button" title="More"><svg class="icon"><use href="#i-more"/></svg></button>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <% files?.forEach(file => { %>
    <%- include('partials/modals/showFile', { file, shared: false }) %>
  <% }) %>
</main>

<% if (!(folders && files && locals.session?.user)) { %>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const main = document.querySelector('main');
      const sidebar = document.querySelector('aside');

      main.querySelectorAll('button, input, select, textarea')
        .forEach((el) => { el.disabled = true; });

      main.querySelectorAll('a[href]').forEach((a) => {
        a.removeAttribute('href');
        a.setAttribute('aria-disabled', 'true');
      });
      sidebar.querySelectorAll('a[href]').forEach((a) => {
        a.removeAttribute('href');
        a.setAttribute('aria-disabled', 'true');
      });

      document.getElementById('signup-modal')?.showModal();
    });
  </script>
<% } %>