<dialog id="login-modal" aria-labelledby="login-title">
  <header>
    <h2 id="login-title">Sign in</h2>
    <p>Access your files and folders.</p>
  </header>

  <form action="/auth/callback/credentials" method="post">
    <!-- Auth.js CSRF token -->
    <input type="hidden" name="csrfToken" id="login-csrf" />

    <!-- Redirect after successful login -->
    <input type="hidden" name="callbackUrl" value="/" />

    <p>
      <label for="login-username">Username</label>
      <input id="login-username" name="username" type="text" autocomplete="off" required />
    </p>

    <p>
      <label for="login-password">Password</label>
      <input id="login-password" name="password" type="password" autocomplete="current-password" required />
    </p>

    <p>
      <input id="login-remember" name="remember" type="checkbox" />
      <label for="login-remember">Remember me</label>
    </p>

    <p>
      <button type="submit">Sign in</button>
    </p>
  </form>

  <p>No account? <a href="#signup-modal">Create one</a></p>

  <p>
    <button type="button">Continue with Google</button>
  </p>

  <form method="dialog">
    <button type="submit">Cancel</button>
  </form>
</dialog>
