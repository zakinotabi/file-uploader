<div class="overlay" id="file-details-overlay"></div>

<aside class="drawer" id="file-details-modal" aria-label="File details">
  <div class="drawer-head">
    <h3>File details</h3>
    <button type="button" class="icon-btn" data-close="file-details-modal" aria-label="Close file details">
      <svg class="icon"><use href="#i-close" /></svg>
    </button>
  </div>

  <div class="drawer-body">
    <div class="thumb">
      <div class="badge-file"><img src="" alt="" /></div>
    </div>

    <div class="drawer-file-name" id="modal-file-name"></div>
    <div class="drawer-file-sub">Uploaded by <span id="modal-file-author">Unknown</span></div>

    <dl class="meta-list">
      <div class="meta">
        <dt>Type</dt>
        <dd id="modal-file-mimetype">—</dd>
      </div>
      <div class="meta">
        <dt>Size</dt>
        <dd id="modal-file-size">—</dd>
      </div>
      <div class="meta">
        <dt>Uploaded</dt>
        <dd><time id="modal-file-date"></time></dd>
      </div>
      <div class="meta">
        <dt>Folder</dt>
        <dd><a id="modal-file-folder-link" href="#">View Folder</a></dd>
      </div>
      <div class="meta">
        <dt>Storage</dt>
        <dd id="modal-file-storage">—</dd>
      </div>
    </dl>
  </div>

  <div class="drawer-foot">
    <a id="modal-file-download" class="btn primary" href="#">
      <svg class="icon"><use href="#i-download" /></svg> Download
    </a>

    <% if (!locals.shared) { %>
    <button type="button" id="modal-file-delete-button" class="btn danger" title="Delete file" data-open="delete-file-modal">
      <svg class="icon"><use href="#i-trash" /></svg>
    </button>
    <% } %>
  </div>
</aside>
