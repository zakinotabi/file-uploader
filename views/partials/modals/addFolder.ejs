<dialog id="new-folder-modal" aria-labelledby="new-folder-title">
  <header>
    <h2 id="new-folder-title">New folder</h2>
    <p>Create a folder to organise your files.</p>
  </header>

  <form action="/folders" method="post">
    <p>
      <label for="folder-name">Folder name</label>
      <input id="folder-name" name="name" type="text" maxlength="120" required />
    </p>

    <p>
      <label for="folder-parent">Parent folder</label>
      <select id="folder-parent" name="parentId">
        <option value="">My Drive (root)</option>
        <option value="1">Design Assets</option>
        <option value="2">Contracts 2026</option>
        <option value="3">Team Photos</option>
        <option value="4">Marketing</option>
        <option value="5">Archive</option>
      </select>
    </p>

    <fieldset>
      <legend>Visibility</legend>
      <p>
        <input id="folder-private" name="visibility" type="radio" value="private" checked />
        <label for="folder-private">Private</label>
      </p>
      <p>
        <input id="folder-shared" name="visibility" type="radio" value="shared" />
        <label for="folder-shared">Shareable via link</label>
      </p>
    </fieldset>

    <p>
      <button type="submit">Create folder</button>
      <button type="reset">Reset</button>
    </p>
  </form>

  <form method="dialog">
    <button type="submit">Cancel</button>
  </form>
</dialog>
