<aside class="sidebar">
  <div class="brand">
    <div class="brand-mark"><svg class="icon"><use href="#i-rain-cloud-big"/></svg></div>
    Btfsplk Cloud
  </div>

  <a class="nav-item <%= currentPath === '/' ? 'active' : '' %>" href="/"><svg class="icon"><use href="#i-drive"/></svg> My Drive</a>
  <a class="nav-item <%= currentPath === '/folders' ? 'active' : '' %>" href="/folders"><svg class="icon"><use href="#i-folder"/></svg> All folders</a>
  <a class="nav-item <%= currentPath === '/files' ? 'active' : '' %>" href="/files"><svg class="icon"><use href="#i-file"/></svg> All files</a>
  <a class="nav-item <%= currentPath === '/files/shared' ? 'active' : '' %>" href="/files/shared"><svg class="icon"><use href="#i-public"/></svg> Shared</a>
  <div class="nav-item"><svg class="icon"><use href="#i-trash"/></svg> Trash</div>

  <div class="nav-label">Folders</div>
  <% if ( folders && folders.length) { %>
    <% folders.forEach(folder => { %>
      <a class="nav-item <%= currentPath === '/folders/' + folder.id ? 'active' : '' %>" href="/folders/<%= folder.id %>">
        <svg class="icon"><use href="#i-folder"/></svg>
        <span><%= folder.folderName %></span>
        <% if (folder.public) { %><svg class="icon folder-public-icon"><use href="#i-public" /></svg><% } %>
      </a>
    <% }) %>
  <% } %>

  <div class="sidebar-foot">
    <div class="storage">
      <div class="storage-top"><span>Storage</span><span> <%= userStorage|| '110 MB' %>/ 500 MB</span></div>
     <div class="meter"><i style="width: <%= spaceUsed  %>%;"></i></div>
      <div class="hint"><%= spaceUsed %> % of your plan used</div>
    </div>
    <div class="user-chip">
      <div class="avatar"><img src="https://api.dicebear.com/10.x/initials/svg?seed=<%= locals.session?.user?.name || 'user'  %>&backgroundColor=6b705c,a5a58d,b98b73,7c9082,8e9aaf,9c6b58" alt=""></div> 
      <div>
        <div class="u-name"><%= locals.session?.user?.name || 'user' %></div>
        <div class="u-mail"><%= locals.session?.user?.username || 'email' %></div>
      </div>
    </div>
  </div>
</aside>
