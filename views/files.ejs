<div class="page-head split">
  <div>
    
  <h1>
    <% if (locals.currentFolder) { %>
    <span class="folder-opened"><%= currentFolder %> </span> &gt; 
    <% } %>
    Files
  </h1>

    <div class="meta"><%= (files?.length || 0) %> files</div>
  </div>
  <div class="page-head-actions">
    <div class="seg compact">
      <button type="button" title="Grid"><svg class="icon"><use href="#i-grid"/></svg></button>
      <button class="on" type="button" title="List"><svg class="icon"><use href="#i-list"/></svg></button>
    </div>
    <% if (!locals.shared && !locals.sharedCollection) { %>
    <button class="btn primary" type="button" data-open="add-file-modal"><svg class="icon"><use href="#i-upload"/></svg> Upload file</button>
    <% } %>
  </div>
</div>

<% if (files.length !== 0) { %>
<div class="table">
  
  <table class="file-table">
    <thead>
      <tr>
        <th>Name</th>
        <th class="folder-column">Folder</th>
        <th class="size-column">Size</th>
        <th class="date-column">Uploaded</th>
        <% if (!locals.shared) { %>
        <th class="visibility-column">Visibility</th>
        <% } %>
        <th class="actions-column"></th>
      </tr>
    </thead>
    <tbody>
      <% files?.forEach(file => { %>
        <tr class="js-file file-modal-open" data-file-id="<%= file.id %>">
          <td>
            <div class="fcell">
              <div class="badge-file"><img src="https://icon-forge.el3zahaby.workers.dev/file-icon?ext=<%= file.fileName.split('.')[1] || "file"%>" alt=""></div>
              <div style="min-width:0">
                <div class="fname"><%= file.fileName %></div>
              </div>
            </div>
          </td>
          <td class="folder-column"><%= file.folderName || file.folder?.folderName || 'Unsorted' %></td>
          <td class="size-column"><%= file.size %></td>
          <td class="date-column"><%= file.createdAt?.toLocaleDateString() || '' %></td>
          <% if (!locals.shared) { %>
          <td class="visibility-column">
            <span class="visibility-status <%= file.public ? 'public' : 'private' %>">
              <% if (file.public) { %><svg class="icon"><use href="#i-public" /></svg><% } %>
              <%= file.public ? 'Public' : 'Private' %>
            </span>
          </td>
          <% } %>
          <td class="actions-column">
            <div class="actions" onclick="event.stopPropagation()">
              <a class="mini" href="/files/<%= file.id %>/download" title="Download"><svg class="icon"><use href="#i-download"/></svg></a>
              <button class="mini file-details-button" type="button" data-file-id="<%= file.id %>" title="Details"><svg class="icon"><use href="#i-share"/></svg></button>
              <button class="mini" type="button" title="More"><svg class="icon"><use href="#i-more"/></svg></button>
            </div>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
   <% } %>
</div>

<% files?.forEach(file => { %>
  <%- include('partials/modals/showFile', { file, shared: Boolean(locals.shared || locals.sharedCollection) }) %>
<% }) %>
