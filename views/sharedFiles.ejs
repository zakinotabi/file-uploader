<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= locals.currentFolder ? `${currentFolder} - ` : '' %>Shared Files</title>
    <link rel="stylesheet" href="/css/base.css" />
    <link rel="stylesheet" href="/css/files.css" />
    <link rel="stylesheet" href="/css/modals.css" />
    <link rel="stylesheet" href="/css/sharedFiles.css" />
  </head>
  <body>
    <%- include('partials/icons') %>
    <main class="content"><%- include('files') %></main>

    <script>
      document.querySelectorAll('.file-modal-open').forEach((row) => {
        row.addEventListener('click', () => {
          const dialog = document.getElementById(`file-modal-${row.dataset.fileId}`);
          dialog.showModal();
        });
      });

      document.querySelectorAll('.file-details-button').forEach((button) => {
        button.addEventListener('click', () => {
          const dialog = document.getElementById(`file-modal-${button.dataset.fileId}`);
          dialog.showModal();
        });
      });
    </script>
  </body>
</html>
