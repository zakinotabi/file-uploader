<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Btfsplk Cloud</title>
    <link rel="stylesheet" href="/css/base.css" />
    <link rel="stylesheet" href="/css/layout.css" />
    <link rel="stylesheet" href="/css/modals.css" />
    <link rel="stylesheet" href="/css/<%= locals.pageStyle || 'dashboard' %>.css" />
  </head>
  <body>
    <%- include('partials/icons') %>

    <div class="site-shell">
      <div class="dashboard-shell">
        <%- include('partials/sidebar') %>

        <div class="main-panel">
          <%- include('partials/topbar') %>

          <div class="content"><%- body %></div>
        </div>
      </div>

      <%- include('partials/modals/login') %> <%- include('partials/modals/signup') %> <%- include('partials/modals/addFile') %> <%-
      include('partials/modals/addFolder') %> <%- include('partials/modals/deleteFile') %> <%- include('partials/footer') %>
    </div>
  </body>
  <script>
    // set the file dialog buttons and share link
    function setFileModalVisibility(dialog, isPublic) {
      const privateButton = dialog.querySelector('.file-private-option');
      const publicButton = dialog.querySelector('.file-public-option');
      const publicValue = dialog.querySelector('.file-public-value');
      const shareLinkSlot = dialog.querySelector('.file-share-link-slot');
      const shareLinkWrap = dialog.querySelector('.file-share-link-wrap');
      const shareLink = dialog.querySelector('.file-share-link');
      const fileId = dialog.dataset.fileId;

      privateButton.classList.toggle('active', !isPublic);
      publicButton.classList.toggle('active', isPublic);
      privateButton.setAttribute('aria-pressed', isPublic ? 'false' : 'true');
      publicButton.setAttribute('aria-pressed', isPublic ? 'true' : 'false');

      publicValue.value = isPublic ? 'true' : 'false';
      shareLinkSlot.classList.toggle('is-visible', isPublic);
      shareLinkWrap.hidden = !isPublic;
      shareLink.href = `/files/shared/${fileId}`;
      shareLink.textContent = `${window.location.origin}/files/shared/${fileId}`;
    }

    // set the folder dialog buttons and share link
    function setFolderModalVisibility(dialog, isPublic) {
      const privateButton = dialog.querySelector('.folder-private-option');
      const publicButton = dialog.querySelector('.folder-public-option');
      const publicValue = dialog.querySelector('.folder-public-value');
      const shareLinkSlot = dialog.querySelector('.share-link-slot');
      const shareLinkWrap = dialog.querySelector('.folder-share-link-wrap');
      const shareLink = dialog.querySelector('.folder-share-link');
      const folderId = dialog.dataset.folderId;

      privateButton.classList.toggle('active', !isPublic);
      publicButton.classList.toggle('active', isPublic);
      privateButton.setAttribute('aria-pressed', isPublic ? 'false' : 'true');
      publicButton.setAttribute('aria-pressed', isPublic ? 'true' : 'false');

      publicValue.value = isPublic ? 'true' : 'false';
      shareLinkSlot.classList.toggle('is-visible', isPublic);
      shareLinkWrap.hidden = !isPublic;
      shareLink.href = `/folders/shared/${folderId}`;
      shareLink.textContent = `${window.location.origin}/folders/shared/${folderId}`;
    }

    // open a file dialog when its row is clicked
    document.querySelectorAll('.file-modal-open').forEach((row) => {
      row.addEventListener('click', () => {
        const dialog = document.getElementById(`file-modal-${row.dataset.fileId}`);
        dialog.showModal();
      });
    });

    // open a file dialog from an action button
    document.querySelectorAll('.file-details-button').forEach((button) => {
      button.addEventListener('click', () => {
        const dialog = document.getElementById(`file-modal-${button.dataset.fileId}`);
        dialog.showModal();
      });
    });

    // open a folder share dialog
    document.querySelectorAll('.folder-share-button').forEach((button) => {
      button.addEventListener('click', () => {
        const dialog = document.getElementById(`share-folder-modal-${button.dataset.folderId}`);
        dialog.showModal();
      });
    });

    // switch file visibility
    document.querySelectorAll('.file-private-option').forEach((button) => {
      button.addEventListener('click', () => {
        const dialog = document.getElementById(`file-modal-${button.dataset.fileId}`);
        setFileModalVisibility(dialog, false);
      });
    });

    document.querySelectorAll('.file-public-option').forEach((button) => {
      button.addEventListener('click', () => {
        const dialog = document.getElementById(`file-modal-${button.dataset.fileId}`);
        setFileModalVisibility(dialog, true);
      });
    });

    // switch folder visibility
    document.querySelectorAll('.folder-private-option').forEach((button) => {
      button.addEventListener('click', () => {
        const dialog = document.getElementById(`share-folder-modal-${button.dataset.folderId}`);
        setFolderModalVisibility(dialog, false);
      });
    });

    document.querySelectorAll('.folder-public-option').forEach((button) => {
      button.addEventListener('click', () => {
        const dialog = document.getElementById(`share-folder-modal-${button.dataset.folderId}`);
        setFolderModalVisibility(dialog, true);
      });
    });

    // initialize file and folder dialogs
    document.querySelectorAll('.file-visibility-form').forEach((form) => {
      const dialog = document.getElementById(`file-modal-${form.dataset.fileId}`);
      const publicButton = dialog.querySelector('.file-public-option');
      const isPublic = publicButton.getAttribute('aria-pressed') === 'true';
      setFileModalVisibility(dialog, isPublic);
    });

    document.querySelectorAll('.folder-modal').forEach((dialog) => {
      const publicButton = dialog.querySelector('.folder-public-option');
      const isPublic = publicButton.getAttribute('aria-pressed') === 'true';
      setFolderModalVisibility(dialog, isPublic);
    });

    // close the dialog after saving file visibility
    document.querySelectorAll('.file-visibility-form').forEach((form) => {
      form.addEventListener('submit', () => {
        const dialog = document.getElementById(`file-modal-${form.dataset.fileId}`);
        dialog.close();
      });
    });

    // close the dialog after saving folder visibility
    document.querySelectorAll('.folder-visibility-form').forEach((form) => {
      form.addEventListener('submit', () => {
        const dialog = document.getElementById(`share-folder-modal-${form.dataset.folderId}`);
        dialog.close();
      });
    });
  </script>
</html>
