<main>
  <h1>Folders</h1>

  <button type="button" data-open="new-folder-modal">New folder</button>

  <ul>
    <% folders.forEach(folder => { %>
      <li>
        <article>
          <h2><a href="/folders/<%= folder.id %>"><%= folder.folderName %></a></h2>
          <p><%= folder._count.files %> files &middot; <%= folder.totalSize %> &middot; created <time datetime="<%= folder.createdAt %>"></time></p>

          <form action="/folders/<%= folder.id %>/delete" method="POST">
            <input type="hidden" name="_method" value="DELETE" />
            <button type="submit">Delete</button>
          </form>

          <details>
            <summary>Rename</summary>
            <form action="/folders/<%= folder.id %>/rename" method="POST">
              <input type="hidden" name="_method" value="PUT" />
              <label for="rename-folder-<%= folder.id %>">New name</label>
              <input id="rename-folder-<%= folder.id %>" name="name" type="text" value="<%= folder.folderName %>" maxlength="100" required />
              <button type="submit">Save</button>
            </form>
          </details>

          <button type="button" data-open="new-share-modal">Share folder</button>
        </article>
      </li>
    <% }) %>
  </ul>
</main>